<main class="container">

  {{#if noData}}

    <div class="card">
      <h1>There is no battle report available</h1>
    </div>

  {{else}}

    <div class="toolbar">
      <a class="btn" href="/batalles">← Back to Battles</a>
    </div>

    <h1>Battle Report #{{battle.num_battle}}</h1>

    <section class="card">
      <h2>Battle Overview</h2>

      <div class="resource-grid compact">
        <div>
          <img src="/img/swords_icon.png" alt="Winner">
          <strong>{{battle.winner}}</strong>
          <span>Winner</span>
        </div>

        <div>
          <img src="/img/wood.png" alt="Wood">
          <strong>{{battle.wood_acquired}}</strong>
          <span>Wood Obtained</span>
        </div>

        <div>
          <img src="/img/iron.png" alt="Iron">
          <strong>{{battle.iron_acquired}}</strong>
          <span>Iron Obtained</span>
        </div>
      </div>
    </section>
    </section>

<section class="card">
  <h2>Battle Log</h2>

  {{#if log}}
    <ol class="battle-log" start="{{primerLog}}">
      {{#each log}}
        <li>{{log_entry}}</li>
      {{/each}}
    </ol>

    <div class="paginacio">
      {{#if hiHaPrevLog}}
        <a class="btn" href="/informe?informe={{battle.num_battle}}&paginaLog={{paginaLogAnt}}">
          Previous
        </a>
      {{/if}}

      <span>Page {{paginaLogVisual}}</span>

      {{#if hiHaNextLog}}
        <a class="btn" href="/informe?informe={{battle.num_battle}}&paginaLog={{paginaLogSeg}}">
          Next
        </a>
      {{/if}}
    </div>

  {{else}}
    <p>No log lines were saved for this battle.</p>
  {{/if}}
</section>

    <section class="card">
